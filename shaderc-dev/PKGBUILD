# Maintainer: nyfair <nyfair2012@gmail.com>
pkgname=shaderc-dev
pkgver=2026.2
pkgrel=1
pkgdesc='Collection of tools, libraries and tests for shader compilation'
arch=('x86_64')
url="https://github.com/google/shaderc/"
license=('Apache')
source=("git+https://github.com/google/shaderc"
        "git+https://github.com/KhronosGroup/glslang"
        "git+https://github.com/KhronosGroup/SPIRV-Headers"
        "git+https://github.com/KhronosGroup/SPIRV-Tools")
md5sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
  cd $srcdir
  cp -r glslang shaderc/third_party/glslang
  cp -r SPIRV-Headers shaderc/third_party/spirv-headers
  cp -r SPIRV-Tools shaderc/third_party/spirv-tools
  sed -i '/namespace/i #include <cstdint>' glslang/glslang/MachineIndependent/SymbolTable.h
  sed -i 's/-fno-exceptions/-fexceptions/g' glslang/CMakeLists.txt
  cd shaderc
  sed -i '/(build-version/,+4d' CMakeLists.txt
  sed -i '/glslc/d' CMakeLists.txt
  rm -rf build && mkdir build && cd build
  cmake .. -G "MinGW Makefiles" -DCMAKE_INSTALL_PREFIX=/opt -DCMAKE_BUILD_TYPE=Release \
    -DSHADERC_SKIP_TESTS=ON -DSHADERC_SKIP_COPYRIGHT_CHECK=ON -DSHADERC_SKIP_INSTALL=ON -DSHADERC_SKIP_EXAMPLES=ON -DENABLE_SPIRV_TOOLS_INSTALL=ON
  cmake --build .
}

package() {
  cd $srcdir/shaderc
  mkdir -p $pkgdir/opt/lib/pkgconfig
  cp -r libshaderc/include $pkgdir/opt
  cp -r libshaderc_util/include/libshaderc_util $pkgdir/opt/include
  cp build/libshaderc/libshaderc_combined.a $pkgdir/opt/lib
  cp build/shaderc_combined.pc $pkgdir/opt/lib/pkgconfig
}
